<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Development signing without a provisioning profile: no restricted
	     entitlements (keychain-access-groups gets the app AMFI-killed at launch).
	     Library validation stays off so non-vendored/dev builds can load Homebrew libs. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
